{
  "name": "@zencss/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Build, watch, lint and explain ZenCSS from the command line.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
